#!/bin/sh
# Pushing main publishes the site to https://keikigames.com (Cloudflare Pages project "keikigames").
# Skip with: SKIP_DEPLOY=1 git push
set -e
cd "$(git rev-parse --show-toplevel)"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  if [ -n "$SKIP_DEPLOY" ]; then
    echo "pre-push: SKIP_DEPLOY set, not publishing."
    exit 0
  fi
  if [ "$local_sha" != "$(git rev-parse HEAD)" ] || ! git diff --quiet HEAD; then
    echo "pre-push: check out the commit you're pushing with a clean working tree so the deploy matches it." >&2
    exit 1
  fi
  if [ ! -f .env ]; then
    echo "pre-push: .env with CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID is missing." >&2
    exit 1
  fi
  set -a && . ./.env && set +a
  echo "pre-push: publishing to keikigames.com..."
  npm run deploy
done
